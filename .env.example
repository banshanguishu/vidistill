DASHSCOPE_API_KEY=sk-xxx-your-key-here

# Optional: override the log directory. Defaults to /tmp/vidistill (same as output_dir).
# In Docker, set this to a mounted volume path so logs survive container restarts.
# LOG_DIR=/var/log/vidistill

# Optional: Netscape 格式 cookies.txt 路径，传给 yt-dlp 带登录态访问。
# B 站尤其需要：无登录 cookie 时 playurl 接口会被风控拦截（HTTP 412）。
# 用浏览器扩展（如 "Get cookies.txt LOCALLY"）在 bilibili 登录页导出，建议用小号。
# 容器内配合 docker-compose 的卷挂载，路径写挂载后的容器内路径。
# YTDLP_COOKIES=/app/cookies.txt
